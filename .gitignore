# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
coverage/
*.tsbuildinfo
graphify-out/

# Environment variables
.env.local
.env.*.local
# Note: .env.development and .env.production are committed for team consistency

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.vscode/
.idea/
# Claude Code config is personal (like .vscode/.idea) EXCEPT the shared
# pieces: the permission allowlist (encodes this repo's verification gate so
# every contributor's agent stops re-approving the same commands), and the
# agents/ + skills/ directories (the cheap-model delegation layer — gates
# runner, CI watcher, fixture repair — which is workflow, not preference).
# Pattern must be `.claude/*`, not `.claude/` — git never descends into an
# ignored DIRECTORY, so a negation inside one has no effect.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/skills/
*.swp
*.swo
*~
.DS_Store

# State files
herobyte-state.json
herobyte-state*.json
herobyte-state*.json.tmp
# Atomic-write staging files carry a .<pid>.<n>.tmp suffix (see
# StatePersistence.saveToDisk). They hold full room state INCLUDING
# whispers, so they must never be committable by an accidental
# `git add apps/server`.
herobyte-state*.json.*.tmp
herobyte-state.e2e.json
herobyte-state.e2e.json.tmp

# Content-addressed upload store (user data, never committed)
herobyte-assets/
herobyte-assets-e2e/
herobyte-maps.json
herobyte-maps.json.tmp
herobyte-maps*.json
herobyte-maps*.json.tmp
vtt-state.json
herobyte-room-secret.json
test-secret.json
playwright-report/
test-results/
.tmp/

# Lighthouse CI cache
.lighthouseci/
C:\\Users\\*\\AppData\\Local\\lighthouse.*/

# MCP config with secrets
.mcp.json

# OS
Thumbs.db

# Image working files (originals and exports only, not working files)
*.psd
*.ai
*.sketch
*.xcf
*.afdesign
*.afphoto
*:Zone.Identifier

# Vitest writes these transient config timestamps next to the config file
vitest.config.ts.timestamp-*

# Opt-in perf benchmark kept locally (PERF_BENCH=1); its own header says never commit
apps/client/src/features/render/__tests__/zz_perfbench.test.ts

# A Windows absolute path handed to a POSIX redirect does not create directories — the
# colon and backslashes collapse and the whole path becomes ONE filename in the current
# directory, which for anything run here is the repo root. A subagent did exactly this
# (2026-08-13) and the resulting `...AppData...run_final.json` matched format:check's root
# `*.{js,json,md}` glob, reddening that gate under a filename the author had never seen —
# while CI, which checks out clean, stayed green.
#
# Prettier 3 reads .gitignore by default, so this one line serves both tools: the gate stays
# honest AND a stray `git add .` cannot commit the debris. The real fix is that agents write
# no files at all (.claude/agents/ci-watcher.md); this is insurance for the shape we've seen.
#
# Not the first time: the `C:\\Users\\*\\AppData\\Local\\lighthouse.*/` line under "Lighthouse
# CI cache" above is the same phenomenon from a different tool, patched by its literal name.
# This rule generalises it. That one is left in place as documentation of the precedent.
/*AppData*
